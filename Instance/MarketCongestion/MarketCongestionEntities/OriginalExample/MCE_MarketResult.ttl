######################################################################
# 1) NORD POOL — FORWARD (ENERGY MARKET)
######################################################################

# 1.1 MarketVenue (Nord Pool)
<urn:uuid:1a5bb7c2-a527-4bba-9c9a-21b62b848f40>
      rdf:type nc:MarketVenue ;
      cim:IdentifiedObject.mRID "1a5bb7c2-a527-4bba-9c9a-21b62b848f40" ;
      cim:IdentifiedObject.name "Nord Pool" ;
      nc:MarketVenue.rulebookRef <https://www.nordpoolgroup.com/en/trading/Rules-and-regulations/> .

# 1.2 MarketProductType – Forward electricity (monthly)
<urn:uuid:7f56c17d-1289-48c2-9385-fcc1da40a243>
      rdf:type nc:MarketProductType ;
      cim:IdentifiedObject.mRID "7f56c17d-1289-48c2-9385-fcc1da40a243" ;
      cim:IdentifiedObject.name "Power Forward – Monthly" ;
      nc:MarketProductType.kind nc:MarketProductKind.forward ;
      nc:MarketProductType.commodity nc:MarketCommodityKind.electricity ;
      nc:MarketProductType.productResolution "P1M"^^xsd:duration ;
      nc:MarketProductType.applicabilityLead "P1M"^^xsd:duration ;
      nc:MarketProductType.clearingLag "PT0S"^^xsd:duration ;
      nc:MarketProductType.settlementLag "P2D"^^xsd:duration ;
      nc:MarketProductType.isSettlementFromEnd "true"^^xsd:boolean .

# 1.3 MarketVenueProduct – Forward Nordic System
<urn:uuid:be8bd28c-953f-4b54-b23e-0137b86f4a30>
      rdf:type nc:MarketVenueProduct ;
      cim:IdentifiedObject.mRID "be8bd28c-953f-4b54-b23e-0137b86f4a30" ;
      cim:IdentifiedObject.name "Nord Pool Forward – Nordic System" ;
      nc:MarketVenueProduct.marketVenue <urn:uuid:1a5bb7c2-a527-4bba-9c9a-21b62b848f40> ;
      nc:MarketVenueProduct.matchingMethod nc:MarketMatchingMethodKind.auction ;
      nc:MarketVenueProduct.productStatus nc:VenueProductStatusKind.active ;
      nc:MarketVenueProduct.marketArea nc:MarketAreaKind.system ;
      nc:MarketVenueProduct.marketAreaName "Nordic System" ;
      nc:MarketVenueProduct.marketAreaRef <https://example.org/marketareas/nordic-system> ;
      nc:MarketVenueProduct.gateClosureClock "12:00:00Z"^^xsd:time ;
      nc:MarketVenueProduct.tradingDayOfWeek nc:DayOfWeekKind.businessDay ;		# We do not have BusinessDay, only Weekday - we should consider adding it
      nc:MarketVenueProduct.productType <urn:uuid:7f56c17d-1289-48c2-9385-fcc1da40a243> .

# 1.4 MarketInstrument – one monthly forward (ticker from Nord Pool file)
# Example ticker: "FWD_NORDIC_M01-26" (replace with actual ticker from download)
<urn:uuid:f72107e2-b8bc-4e3d-856a-04e49bb84694>
      rdf:type nc:MarketInstrument ;
      cim:IdentifiedObject.mRID "f72107e2-b8bc-4e3d-856a-04e49bb84694" ;
      cim:IdentifiedObject.name "FWD_NORDIC_M01-26" ;
      nc:MarketInstrument.venueProduct <urn:uuid:be8bd28c-953f-4b54-b23e-0137b86f4a30> ;
      nc:MarketInstrument.observedProperty nc:MarketObservedPropertyKind.price ;
      nc:MarketInstrument.temporalApplicability "2026-01-01T00:00:00+01:00"^^xsd:dateTime ;		# Remember that the time of the MarketInstrument will be in the Schedule or snapshot file
      nc:MarketInstrument.unitCode "EUR/MWH" ;
      nc:MarketInstrument.currency "EUR" ;
      nc:MarketInstrument.value "55.30"^^xsd:decimal ;
      nc:MarketInstrument.marketAreaName "Nordic System" .

