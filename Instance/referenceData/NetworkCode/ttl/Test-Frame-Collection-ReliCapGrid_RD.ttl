@prefix provcim:  <https://cim4.eu/ns/provcim#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .


#################################################################
# Frame Collection for ReliCapGrid / Reference Dataset
#################################################################

<https://energy.referencedata.eu/Test/Frame-Collection-ReliCapGrid/1.0>
    a dcat:Dataset ;
    skos:prefLabel "Energy Reference Data Frame Collection for ReliCapGrid"@en ;
	skos:definition "Reference dataset listing recognized frame that should be use in dcterms:spatial."@en ;
	dcterms:description "Reference dataset containing recognized frame identities for use area of responsebility."@en ;
    dcterms:title "Test-Frame-Collection-ReliCapGrid_RD" ;
	dcterms:identifier "50cc303c-df37-4b86-80a6-f6d312268661" ;
    dcterms:publisher <https://www.entsoe.eu/> ;
    dcterms:rights "Copyright" ;
    dcterms:rightsHolder "ENTSO-E" ;
    dcterms:issued "2026-08-08T00:00:00Z"^^xsd:dateTime ;
    prov:generatedAtTime "2026-08-08T00:00:00Z"^^xsd:dateTime ;
    dcat:version "1.0.0" ;
    adms:versionNotes "Initial version of the Energy Reference Data Frame Collection that is part of the ReliCapGrid ENTSO-E test model."@en ;
    dcat:isVersionOf <https://energy.referencedata.eu/Test/Frame-Collection-ReliCapGrid> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:accessRights <https://energy.referencedata.eu/Confidentiality/Public> ;
	dcterms:hasPart <https://energy.referencedata.eu/test/FrameScheme/1.0#collection_frame> .


#################################################################
# Collection of Frames
#################################################################

<https://energy.referencedata.eu/test/FrameScheme/1.0#collection_frame>
    a prov:Collection ;
    dcterms:identifier "b0c0950a-2dcf-44f6-8a82-d47305b9987e" ;
    skos:prefLabel "Collection of recognized frames identities for ReliCapGrid."@en ;
    prov:hadMember
		<https://energy.referencedata.eu/test/frame/Svedala-Transmission> ,
        <https://energy.referencedata.eu/test/frame/Galia-Transmission> ,
		<https://energy.referencedata.eu/test/frame/Espheim-Portheim-Transmission> ,
		<https://energy.referencedata.eu/test/frame/Belgovia-Transmission> ,
		<https://energy.referencedata.eu/test/frame/Britheim-Transmission> ,
		<https://energy.referencedata.eu/test/frame/Espheim-Transmission> ,
		<https://energy.referencedata.eu/test/frame/Nordheim-Transmission> ,
		<https://energy.referencedata.eu/test/frame/Portheim-Transmission> ,
		<https://energy.referencedata.eu/test/frame/DC-Espheim-Svedala-Transmission> ,
		<https://energy.referencedata.eu/test/frame/DC-Nordheim-Galia-Transmission> ,
		<https://energy.referencedata.eu/test/frame/Espheim-DC-Espheim-Svedala-Transmission> ,
		<https://energy.referencedata.eu/test/frame/Svedala-DC-Espheim-Svedala-Transmission> ,
		<https://energy.referencedata.eu/test/frame/Nordheim-DC-Nordheim-Galia-Transmission> ,
		<https://energy.referencedata.eu/test/frame/Galia-DC-Nordheim-Galia-Transmission> .


#################################################################
# List of Frame
#################################################################

<https://energy.referencedata.eu/test/frame/Svedala-Transmission>
    a provcim:Frame ;
    skos:prefLabel "Svedala-Transmission"@en ;
	dcterms:identifier "4e42ef1c-7a5f-4cbb-bc24-582975965828" ;
	dcterms:description "Recognized transmission frame representing the spatial applicability of resources related to the Svedala transmission grid. Models version describing different elements of the grid fits into."@en .


<https://energy.referencedata.eu/test/frame/Galia-Transmission>
    a provcim:Frame ;
    skos:prefLabel "Galia-Transmission"@en ;
	dcterms:identifier "188b7f96-efeb-4033-bdfc-e5f1e915cef1" ;
	dcterms:description "Recognized frame as dcterms:spatial of the Galia Transmission grid that a provcim:Model can fit into."@en ;
	provcim:hasMinVoltage [
        a qudt:QuantityValue ;
        qudt:numericValue "130" ;
        qudt:unit unit:KiloV
    ] ;
    provcim:hasMaxVoltage [
        a qudt:QuantityValue ;
        qudt:numericValue "420" ;
        qudt:unit unit:KiloV
    ] ;
	geo:hasGeometry [
		a geo:Geometry ;
		geo:asGeoJSON """{
			"type": "Polygon",
			"coordinates": [[
			[-5.1, 48.6],
			[-4.7, 47.7],
			[-2.0, 46.2],
			[-1.4, 44.7],
			[-1.7, 43.4],
			[0.8, 42.7],
			[3.2, 42.5],
			[5.4, 43.3],
			[7.5, 43.7],
			[7.4, 44.8],
			[6.5, 46.2],
			[7.2, 48.6],
			[6.0, 49.5],
			[2.5, 51.1],
			[0.0, 50.9],
			[-1.6, 49.9],
			[-4.0, 48.8],
			[-5.1, 48.6]
		  ]]
		}"""^^geo:geoJSONLiteral;
	] .

