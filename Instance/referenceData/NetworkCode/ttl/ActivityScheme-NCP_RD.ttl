#################################################################
# Activity Scheme / Reference Dataset
#################################################################

<https://energy.referencedata.eu/ActivityScheme/1.0>
    a dcat:Dataset ;
    skos:prefLabel "Energy Reference Data Activity Scheme"@en ;
	skos:definition "Reference dataset and concept scheme listing recognized activity identities that may be used as the object of prov:wasGeneratedBy."@en ;
	dcterms:description "Reference dataset containing recognized activity identities for use in provenance references."@en ;
    dcterms:title "ActivityScheme_RD" ;
	dcterms:identifier "afab3d78-d706-466e-931a-db0bf847b904" ;
    dcterms:publisher <https://www.entsoe.eu/> ;
    dcterms:rights "Copyright" ;
    dcterms:rightsHolder "ENTSO-E" ;
    dcterms:issued "2026-07-16T00:00:00Z"^^xsd:dateTime ;
    prov:generatedAtTime "2026-07-16T00:00:00Z"^^xsd:dateTime ;
    dcat:version "1.0.0" ;
    adms:versionNotes "Initial version of the Energy Reference Data Activity Scheme for ReliCapGrid."@en ;
    dcat:isVersionOf <https://energy.referencedata.eu/ActivityScheme> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:accessRights <https://energy.referencedata.eu/Confidentiality/Public> ;
	dcterms:hasPart <https://energy.referencedata.eu/ActivityScheme/1.0#collection_activity> .


#################################################################
# Collection of Activities
#################################################################

<https://energy.referencedata.eu/ActivityScheme/1.0#collection_activity>
    a prov:Collection ;
    dcterms:identifier "209d3b30-a355-4e1e-a831-c11c3eb514d7" ;
    skos:prefLabel "Collection of recognized activities identities for CGMES and NCP."@en ;
    prov:hadMember         
		<https://energy.referencedata.eu/activity/SR-EQ> ,
        <https://energy.referencedata.eu/activity/SR-ER> ,
		<https://energy.referencedata.eu/activity/VF-EQ> ,
		<https://energy.referencedata.eu/activity/REQ-RAS> .

