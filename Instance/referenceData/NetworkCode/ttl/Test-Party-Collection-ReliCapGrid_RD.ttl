#################################################################
# Party Collection for ReliCapGrid / Reference Dataset
#################################################################

<https://energy.referencedata.eu/test/Party-Collection-ReliCapGrid/1.0>
    a dcat:Dataset ;
    skos:prefLabel "Energy Reference Data Party Collection ReliCapGrid"@en ;
	skos:definition "Reference dataset listing recognized Party identities that shall be used as the object of dcterms:publisher and provcim:modelAuthority."@en ;
	dcterms:description "Reference dataset containing recognized party identities for use in publisher, authority, and provenance references."@en ;
    dcterms:title "Test-Party-Collection-ReliCapGrid_RD" ;
	dcterms:identifier "b77fe0ff-9907-4943-90a7-6e35a178a8ab" ;
    dcterms:publisher <https://www.entsoe.eu/> ;
    dcterms:rights "Copyright" ;
    dcterms:rightsHolder "ENTSO-E" ;
    dcterms:issued "2026-08-08T00:00:00Z"^^xsd:dateTime ;
    prov:generatedAtTime "2026-08-08T00:00:00Z"^^xsd:dateTime ;
    dcat:version "1.0.0" ;
    adms:versionNotes "Initial version of the Energy Reference Data Party Collection for ReliCapGrid."@en ;
    dcat:isVersionOf <https://energy.referencedata.eu/test/Party-Collection-ReliCapGrid> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:accessRights <https://energy.referencedata.eu/Confidentiality/Public> ;
	dcterms:hasPart <https://energy.referencedata.eu/test/PartyScheme/1.0#collection_party> .


